# Galla Ops configuration. Copy to .env, fill in, `chmod 600 .env`.
# Every integration is optional: leave it blank and that part says "Not connected" instead of guessing.

# ── Core ─────────────────────────────────────────────────────────────
# Port the agent listens on (127.0.0.1 only; Caddy proxies to it). ND Ops uses 8090.
PORT=8091
# SQLite database lives here. Outside the repo, survives updates.
DATA_DIR=/var/lib/galla-ops
# All schedules and times in reports.
TIMEZONE=Africa/Cairo
# Brands, subsites, languages and hosts. Copy brands.example.json → brands.json.
BRANDS_FILE=/opt/galla-ops-agent/brands.json
# Public URL of this agent (links in emails, confirm pages).
PUBLIC_BASE_URL=https://galla-ops.elgalla.com
# Signs dashboard sessions, confirm links and Telegram ack buttons. 32+ random chars: openssl rand -base64 48
APPROVAL_SECRET=
# Confirm links (accept baseline) expire after this many hours.
APPROVAL_TTL_HOURS=72
# Command Center password, 12+ characters. Empty = dashboard off.
DASHBOARD_PASSWORD=
OWNER_EMAIL=adham.h.sewelam@gmail.com
OWNER_NAME=Adham

# ── Email to you (Gmail app password "Galla Ops") ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=adham.h.sewelam@gmail.com
# Google Account → Security → App passwords. Never your normal password.
SMTP_PASS=
EMAIL_FROM="Galla Ops <adham.h.sewelam@gmail.com>"
# Extra recipients (comma-separated), and which email types they receive.
# Types: URGENT, RESOLVED, SECURITY, DAILY, WEEKLY SEO, HR, INFO. SECURITY mail contains exact remediation commands.
EMAIL_CC=
EMAIL_CC_PREFIXES=DAILY,WEEKLY SEO

# ── JARVIS on Telegram (your NEW Galla JARVIS bot, not the ND bot) ──
# From @BotFather. Two processes polling one bot token break each other's "I'm on it" button.
TELEGRAM_BOT_TOKEN=
# Run: node --env-file=.env src/tg-setup.js  (after pressing Start on the bot)
TELEGRAM_CHAT_ID=
# Voice model installed by deploy/install-voice.sh (already there if ND Ops installed it)
PIPER_MODEL=/opt/piper/en_GB-alan-medium.onnx
# Minutes to wait for your "I'm on it" tap before the urgent email goes out.
JARVIS_ACK_MINUTES=5

# ── External heartbeat (dead-man's switch) ───────────────────────────
# healthchecks.io ping URL. Pinged after every uptime run; if the VPS/agent dies, healthchecks.io emails you.
HEARTBEAT_URL=

# ── AI (summaries and recommendations only; it cannot trigger actions) ──
# Claude is used if set, else free Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# ── Host sentinels (one secret per host in brands.json → hosts[].secretEnv) ──
# Generate each with: openssl rand -hex 32   — put the SAME value in that host's sentinel config.json.
SENTINEL_SECRET_SHARED=
SENTINEL_SECRET_VPS=
# No report for this many hours → urgent (the sentinel may have been disabled).
SENTINEL_MISSING_HOURS=3

# ── WooCommerce READ-ONLY REST keys (names come from brands.json → sites[].woo) ──
# WooCommerce → Settings → Advanced → REST API → Add key → Permissions: READ. One per shop/subsite.
WC_JBG_EG_KEY=
WC_JBG_EG_SECRET=
WC_JBG_AE_KEY=
WC_JBG_AE_SECRET=
WC_ONECARAT_EG_KEY=
WC_ONECARAT_EG_SECRET=
WC_ONECARAT_AE_KEY=
WC_ONECARAT_AE_SECRET=
WC_ELGALLA_KEY=
WC_ELGALLA_SECRET=

# ── Email deliverability (Keeper) ────────────────────────────────────
# Sending-mailbox passwords, named in brands.json → smtp.passEnv. Optional: without it, DNS checks only.
SMTP_ELGALLA_PASS=
# rcpt = log in + MAIL FROM + RCPT TO, then quit: catches "550 suspicious activity" without sending anything.
# send = also deliver a short canary email to SMTP_CANARY_TO every morning.
SMTP_CANARY_MODE=rcpt
# Recipient used for the probe (default OWNER_EMAIL).
SMTP_CANARY_TO=

# ── Updates: security-release feed (optional) ────────────────────────
# Free key from wordfence.com/threat-intel (Wordfence Intelligence). Without it, only core point releases are flagged.
WORDFENCE_API_KEY=

# ── SEO ──────────────────────────────────────────────────────────────
# base64 of a Google service-account JSON key (add its email as a Restricted user in each Search Console property)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# optional; raises the PageSpeed quota
PAGESPEED_API_KEY=

# ── VPS health (true ONLY on srv1108252, the elgalla.com VPS) ────────
VPS_MONITOR=true
# systemd units that must be active (missing units are ignored). On srv1108252 FrankenPHP runs INSIDE caddy,
# so the separate frankenphp.service is installed but unused: don't list it.
VPS_SERVICES=caddy,redis-server
# PHP slow log, if enabled (FrankenPHP: see deploy/VPS.md)
PHP_SLOWLOG_PATH=
VPS_CPU_ALERT_PCT=85
VPS_RAM_ALERT_PCT=92
VPS_DISK_ALERT_PCT=90
